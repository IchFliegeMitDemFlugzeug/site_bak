<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="BTS API reverse proxy" stopProcessing="true">
                    <match url="^api/(.*)$" />
                    <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
